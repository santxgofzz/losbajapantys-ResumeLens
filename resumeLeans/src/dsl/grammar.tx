ResumeProfile:
    ('CANDIDATE:' name=STRING)?
    ('ROLE:' current_role=STRING)?
    ('LOCATION:' location=STRING)?
    ('SUMMARY:' summary=STRING)?
    'CONTACT:'
    emails*=Email
    phones*=Phone
    'EDUCATION:'
    education*=Education
    'EXPERIENCE:'
    experiences*=Experience
    'NORMALIZED_SKILLS:'
    skills*=Skill
    'EVALUATION:'
    evaluations*=Evaluation
;

Email: 'Email:' email=STRING;
Phone: 'Phone:' phone=STRING;
Education: '-' degree=STRING;
Experience: '-' duration=STRING;
Skill: '-' name=ID;

Evaluation:
    '- Profile evaluated:' evaluated_profile=STRING
    'Qualification pattern:' status=Status
;

Status:
    'ACCEPTED' | 'REJECTED'
;
